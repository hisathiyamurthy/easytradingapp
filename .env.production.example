# EasyTradingApp Production Environment Configuration

ENVIRONMENT=production
LOG_LEVEL=info

API_URL=https://api.easytradingapp.com
FRONTEND_URL=https://app.easytradingapp.com

DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/easytradingapp

REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

RABBITMQ_URL=amqp://guest:${RABBITMQ_PASSWORD}@rabbitmq:5672

SECRET_KEY=${SECRET_KEY}
JWT_SECRET_KEY=${JWT_SECRET_KEY}
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# Admin Account - SET STRONG VALUES IN PRODUCTION!
ADMIN_EMAIL=${ADMIN_EMAIL}
ADMIN_PASSWORD=${ADMIN_PASSWORD}

BROKER_MODE=production

ZERODHA_API_KEY=${ZERODHA_API_KEY}
ZERODHA_API_SECRET=${ZERODHA_API_SECRET}

KOTAK_CLIENT_ID=${KOTAK_CLIENT_ID}
KOTAK_CLIENT_SECRET=${KOTAK_CLIENT_SECRET}

UPSTOX_API_KEY=${UPSTOX_API_KEY}
UPSTOX_API_SECRET=${UPSTOX_API_SECRET}

ANGEL_CLIENT_ID=${ANGEL_CLIENT_ID}
ANGEL_CLIENT_SECRET=${ANGEL_CLIENT_SECRET}

DAILY_LOSS_LIMIT=50000
MAX_POSITION_SIZE=100000
GLOBAL_KILL_SWITCH=false

RATE_LIMIT_PER_MINUTE=60

LOG_FILE_PATH=/var/log/easytradingapp
