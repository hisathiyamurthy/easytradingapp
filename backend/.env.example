# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easytrading

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session
SESSION_TIMEOUT_MINUTES=30

# AWS Secrets Manager (optional)
AWS_REGION=ap-south-1
AWS_SECRET_NAME=prod/easytrading/secret

# Market Data
MARKET_DATA_PROVIDER=yfinance  # yfinance, nsepython, or mock

# OAuth2 (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@easytradingapp.com
