# EasyTradingApp Environment Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=debug

# API
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easytradingapp

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security
SECRET_KEY=change-this-to-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-random-jwt-secret
ENCRYPTION_KEY=change-this-to-32-char-encryption-key

# Admin Account (optional - creates default admin on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecureAdmin123

# Broker Configuration
BROKER_MODE=mock
MOCK_BROKER_URL=http://mock-broker:8001

# Zerodha
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret

# Kotak Neo
KOTAK_CLIENT_ID=your_kotak_client_id
KOTAK_CLIENT_SECRET=your_kotak_client_secret

# Upstox
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret

# Angel One
ANGEL_CLIENT_ID=your_angel_client_id
ANGEL_CLIENT_SECRET=your_angel_client_secret

# Risk Management
DAILY_LOSS_LIMIT=50000
MAX_POSITION_SIZE=100000
GLOBAL_KILL_SWITCH=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_FILE_PATH=/var/log/easytradingapp
